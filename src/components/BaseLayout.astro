---
import '../styles/default.css';
import NavBar from './NavBar.astro';
const { title } = Astro.props;
---
<html lang="eng">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <NavBar/>
    </head>
    <body>
        <slot />
    </body>
</html>
